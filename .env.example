# Copy to .env and fill in. Never commit .env.

# Flask
# development | production (FLASK_ENV is still accepted)
APP_ENV=production
# required in production, >= 32 random chars: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Database (relative sqlite paths live in /app/instance)
DATABASE_URL=sqlite:///wishlist.db

# Email (Mailgun SMTP)
MAIL_SERVER=smtp.mailgun.org
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USERNAME=your-mailgun-username@your-domain.com
MAIL_PASSWORD=your-mailgun-password
MAIL_DEFAULT_SENDER=noreply@your-domain.com
# off = send nothing (testing); admin pages show previews and a warning banner instead
MAIL_DELIVERY=on

# Application
APP_NAME=Christmas Wishlist
# public URL; used in emails and as the WebAuthn origin
APP_URL=https://wishlist.example.com
# bare domain of APP_URL ("localhost" for local development)
WEBAUTHN_RP_ID=wishlist.example.com

# Reverse proxy
# Number of proxies in front of the app whose X-Forwarded-* headers are trusted. Make sure the app port is only
# reachable through that proxy, otherwise clients can spoof these headers.
TRUSTED_PROXY_COUNT=1
# default True in production; set False only for plain-http local testing
SESSION_COOKIE_SECURE=True

# Tokens
# seconds; links are also single-use
MAGIC_LINK_TOKEN_EXPIRY=1800
INVITE_EXPIRY_DAYS=30

# Daily digest: hour (0-23) in the container's TZ (or DIGEST_TIMEZONE)
DAILY_DIGEST_HOUR=9

# First admin, created on start if missing (passwordless: log in with a magic link or passkey)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator

# Optional: ScraperAPI key (https://www.scraperapi.com/) for Amazon/Etsy product auto-fill
SCRAPER_API_KEY=

# Optional: rate-limit storage shared across gunicorn workers (default: per-worker memory)
# RATELIMIT_STORAGE_URI=redis://redis:6379/0
